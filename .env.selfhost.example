# Public address. Use a domain (echo.example.com) for automatic HTTPS,
# or :80 for a LAN-only HTTP deployment.
SITE_ADDRESS=echo.example.com
NEXT_PUBLIC_BASEURL=https://echo.example.com
BASEURL=http://app:3000

# MongoDB bootstrap and application credentials. Use URL-safe values.
MONGO_ROOT_USERNAME=echo_admin
MONGO_ROOT_PASSWORD=replace-with-a-long-random-password
MONGO_APP_USERNAME=echo
MONGO_APP_PASSWORD=replace-with-another-long-random-password

# Authentication, encryption, and internal scheduler secrets.
NEXTAUTH_SECRET=replace-with-at-least-32-random-bytes
JWT_SECRET=replace-with-at-least-32-random-bytes
ENCRYPTION_SECRET_KEY=replace-with-at-least-32-random-bytes-and-back-this-up
CRON_SECRET=replace-with-at-least-32-random-bytes
# LEGACY_ENCRYPTION_SECRET_KEY=only-needed-when-migrating-old-encrypted-data

# Current external integrations.
# Hosted default: set OPENROUTER_API_KEY. For local OpenAI-compatible inference,
# set AI_BASE_URL, AI_MODEL, and optionally AI_API_KEY instead.
OPENROUTER_API_KEY=replace-me
# AI_BASE_URL=http://host.docker.internal:11434/v1
# AI_MODEL=qwen3:8b
# AI_API_KEY=local-no-key
# Per-user daily cap on AI-backed endpoints (chat, mood, insights), so one
# account cannot drain your inference budget. Set to 0 to disable, which is
# usually what you want when running local inference.
# AI_DAILY_LIMIT=

RESEND_API_KEY=replace-me
MAIL_FROM="Echo <echo@example.com>"
NEXT_PUBLIC_IMGBB_API=

# Optional Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
